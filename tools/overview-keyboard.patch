+function selection(windows, selected, active) {
+    const available = windows.filter(window => /^0x[0-9a-f]+$/i.test(window?.address || ""));
+    if (available.some(window => window.address === selected)) return selected;
+    if (available.some(window => window.address === active)) return active;
+    return available[0]?.address || "";
+}
+
+function cycle(windows, selected, backwards) {
+    windows = windows.filter(window => /^0x[0-9a-f]+$/i.test(window?.address || ""));
+    if (!windows.length) return "";
+    const index = windows.findIndex(window => window.address === selected);
+    const next = index < 0 ? (backwards ? windows.length - 1 : 0) : (index + (backwards ? -1 : 1) + windows.length) % windows.length;
+    return windows[next].address;
+}
+
+function command(operation, window, target, usingLua) {
+    if (!window || !/^0x[0-9a-f]+$/i.test(window.address || "")) return [];
+    const address = "address:" + window.address;
+    if (operation === "move" && ((Number.isSafeInteger(target) && target > 0) ||
+        (typeof target === "string" && /^special:[a-z0-9_. -]+$/i.test(target)))) {
+        return usingLua
+            ? ["hyprctl", "repl", 'hl.dispatch(hl.dsp.window.move({workspace="' + target + '",follow=true,window="' + address + '"}));hl.dispatch(hl.dsp.focus({window="' + address + '"}))']
+            : ["hyprctl", "--batch", "dispatch movetoworkspace " + target + "," + address + ";dispatch focuswindow " + address];
+    }
+    if (operation === "swap" && ["left", "right", "up", "down"].includes(target) && !window.floating) {
+        return usingLua
+            ? ["hyprctl", "repl", 'hl.dispatch(hl.dsp.window.swap({direction="' + target + '",window="' + address + '"}))']
+            : ["hyprctl", "--batch", "dispatch focuswindow " + address + ";dispatch swapwindow " + target[0]];
+    }
+    return [];
+}
