@@ -0,0 +1,25 @@
+function desktop(screens) {
+    if (!screens.length) throw new Error("No displays available");
+    for (const screen of screens) {
+        if (![screen.x, screen.y, screen.width, screen.height, screen.scale].every(Number.isFinite) ||
+            Math.min(screen.width, screen.height, screen.scale) <= 0)
+            throw new Error("Invalid display geometry");
+    }
+    const left = Math.floor(Math.min(...screens.map(screen => screen.x)));
+    const top = Math.floor(Math.min(...screens.map(screen => screen.y)));
+    return {
+        x: left,
+        y: top,
+        width: Math.ceil(Math.max(...screens.map(screen => screen.x + screen.width))) - left,
+        height: Math.ceil(Math.max(...screens.map(screen => screen.y + screen.height))) - top,
+        scale: Math.max(...screens.map(screen => screen.scale))
+    };
+}
+
+function visibleWindows(windows, screens) {
+    return windows.filter(window => window.mapped !== false && !window.hidden && screens.some(screen =>
+        window.monitor === screen.monitorId && (window.pinned || window.workspace?.id === screen.workspaceId ||
+            (screen.specialWorkspaceId < 0 && window.workspace?.id === screen.specialWorkspaceId))))
+        .sort((first, second) => Number(second.floating) - Number(first.floating) ||
+            (first.focusHistoryID ?? 999) - (second.focusHistoryID ?? 999));
+}
