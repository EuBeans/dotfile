+import QtQuick
+
+Item {
+    id: root
+    property real selectionX: 0
+    property real selectionY: 0
+    property real selectionWidth: 0
+    property real selectionHeight: 0
+    property real dimOpacity: 0.6
+    property real outlineThickness: 2
+    property real borderRadius: 10
+    readonly property real cutLeft: Math.max(0, Math.min(width, selectionX))
+    readonly property real cutTop: Math.max(0, Math.min(height, selectionY))
+    readonly property real cutRight: Math.max(cutLeft, Math.min(width, selectionX + selectionWidth))
+    readonly property real cutBottom: Math.max(cutTop, Math.min(height, selectionY + selectionHeight))
+    Repeater {
+        model: [Qt.rect(0, 0, root.width, root.cutTop),
+            Qt.rect(0, root.cutBottom, root.width, root.height - root.cutBottom),
+            Qt.rect(0, root.cutTop, root.cutLeft, root.cutBottom - root.cutTop),
+            Qt.rect(root.cutRight, root.cutTop, root.width - root.cutRight, root.cutBottom - root.cutTop)]
+        Rectangle {
+            required property var modelData
+            x: modelData.x
+            y: modelData.y
+            width: modelData.width
+            height: modelData.height
+            color: Qt.rgba(0, 0, 0, root.dimOpacity)
+        }
+    }
+    Rectangle {
+        x: root.cutLeft
+        y: root.cutTop
+        width: root.cutRight - root.cutLeft
+        height: root.cutBottom - root.cutTop
+        visible: width > 0 && height > 0
+        color: "transparent"
+        radius: root.borderRadius
+        border.color: "#ffffff"
+        border.width: root.outlineThickness
+    }
+}
